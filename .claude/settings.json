      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git merge)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset)",
      "PowerShell(git reset *)",
      "PowerShell(git tag)",
      "PowerShell(git tag *)"
