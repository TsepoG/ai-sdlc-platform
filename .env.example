# Copy to .env for local runs (`npm start` loads it if present). Validated by src/config.

# development | test | production
NODE_ENV=development
# HTTP port, 1-65535 (default 8080)
PORT=8080
# fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info
# Version reported by GET /health; CI sets the commit SHA
APP_VERSION=0.0.0-local
# local | test | platform-dev | platform-prod
PLATFORM_ENV=local
# Stage configuration directory, relative to the working directory (default config/stages)
STAGES_DIR=config/stages

# PostgreSQL (docker compose up -d starts one matching these values). In AWS, ECS fills
# host, port, name, user and password from the database secret.
DATABASE_HOST=localhost
# default 5432
DATABASE_PORT=5432
DATABASE_NAME=platform
DATABASE_USER=platform
DATABASE_PASSWORD=change-me-local-only
# true | false (default true). When true the server certificate is always verified; the image
# trusts the RDS CA bundle via NODE_EXTRA_CA_CERTS. The local compose database has no TLS.
DATABASE_SSL=false
# default 10
DATABASE_POOL_MAX=10

# local | s3 (default local)
CONTENT_STORE=local
# Directory for the local content store (default data/content)
CONTENT_DIR=data/content
# Required when CONTENT_STORE=s3
# CONTENT_BUCKET=

# Workflow routes and dev-header identity. Allowed only when PLATFORM_ENV is local or test.
# true | false (default false)
WORKFLOW_API_ENABLED=true
# none | dev-headers (default none)
AUTH_MODE=dev-headers

# Background job worker
# true | false (default true)
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_BACKOFF_BASE_MS=5000
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_MS=300000

# Tests only: a PostgreSQL the test suite may create schemas in (each test file gets its own).
# npm run verify needs it. Matches the docker compose database.
# TEST_DATABASE_URL=postgres://platform:change-me-local-only@localhost:5432/platform
