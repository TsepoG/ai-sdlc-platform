# Copy to .env for local runs (`npm start` loads it if present). Validated by src/config.

# development | test | production
NODE_ENV=development
# HTTP port, 1-65535 (default 8080)
PORT=8080
# fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info
# Version reported by GET /health; CI sets the commit SHA
APP_VERSION=0.0.0-local
# local | platform-dev | platform-prod
PLATFORM_ENV=local
